# Credenciais do login com Google no ambiente LOCAL (`config.toml`).
#
# Copie para `supabase/.env` e preencha. O arquivo real é ignorado pelo git —
# client secret em repositório é segredo publicado.
#
# Como obter, no Google Cloud Console:
#   1. APIs e serviços -> Credenciais -> Criar credenciais -> ID do cliente OAuth
#   2. Tipo: Aplicativo da Web
#   3. Origens JavaScript autorizadas:  http://localhost:3000
#   4. URIs de redirecionamento autorizados:  http://127.0.0.1:54421/auth/v1/callback
#
# Staging e produção NÃO usam este arquivo: lá o provedor é configurado no painel
# do Supabase, com o redirect do domínio daquele ambiente.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
