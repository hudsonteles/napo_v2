{
  "name": "napo",
  "version": "0.0.0",
  "private": true,
  "description": "Napo — canal de venda próprio de pizza napolitana congelada premium",
  "engines": {
    "node": "20.17.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "pnpm --filter @napo/web dev",
    "build": "pnpm --filter @napo/web build",
    "start": "pnpm --filter @napo/web start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "db:sync": "supabase migration up --local && pnpm db:types",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.generated.ts",
    "db:types:check": "supabase gen types typescript --local | git diff --no-index --exit-code packages/db/src/types.generated.ts -",
    "db:push:staging": "supabase db push --linked",
    "db:push:prod": "bash scripts/confirm-prod-deploy.sh napo-prod && supabase db push --linked"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "supabase": "^1.207.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.4"
  }
}
